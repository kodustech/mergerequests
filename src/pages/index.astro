---
import Layout from '../layouts/Layout.astro';
import { getPublishedPosts, formatDate } from '../lib/blog';
import { site } from '../site.config';

const posts = await getPublishedPosts();
const railFor = (key: string) => posts.filter((p) => p.data.platform === key).slice(0, 5);

const title = "Tooling for GitLab, Azure DevOps and Bitbucket | mergerequests.dev";
---

<Layout title={title}>
	<section class="max-w-[62ch] mb-16">
		<p class="text-lg text-stone-700 dark:text-zinc-300 leading-relaxed text-pretty">
			Almost everything written about developer tooling assumes you are on GitHub. This site is for the teams who are not: CI, review, security scanning and delivery metrics on GitLab, Azure DevOps and Bitbucket, including the self-managed and on-premise versions that most vendors forget to document.
		</p>
	</section>

	{site.platforms.map((platform) => {
		const rail = railFor(platform.key);
		return (
			<section class="mb-12 border-t rule pt-6">
				<div class="flex items-baseline justify-between gap-6 mb-1">
					<h2 class="rail-label">{platform.label}</h2>
					{rail.length > 0 && (
						<a href={`/platform/${platform.key}`} class="meta hover:text-cobalt-600 dark:hover:text-cobalt-400 transition-colors">
							All {platform.label}
						</a>
					)}
				</div>
				<p class="text-[15px] text-stone-600 dark:text-zinc-400 mb-5 max-w-[62ch] text-pretty leading-relaxed">
					{platform.blurb}
				</p>

				{rail.length > 0 ? (
					<ul class="space-y-3">
						{rail.map((post) => (
							<li class="min-w-0">
								<a href={`/blog/${post.id}`} class="group flex flex-col sm:flex-row sm:items-baseline sm:gap-4">
									<time class="meta shrink-0 sm:w-24" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
									<span class="text-stone-900 dark:text-zinc-100 group-hover:text-cobalt-600 dark:group-hover:text-cobalt-400 transition-colors min-w-0">{post.data.title}</span>
								</a>
							</li>
						))}
					</ul>
				) : (
					<p class="meta">Nothing here yet.</p>
				)}
			</section>
		);
	})}

	<section class="border-t rule pt-6">
		<p class="text-[15px] text-stone-600 dark:text-zinc-400 max-w-[62ch] text-pretty leading-relaxed">
			Missing something you needed? The gaps are the point, so say which one and it goes on the list. Every page shows the date it was last checked, because vendor pricing and platform support move every month.
		</p>
	</section>
</Layout>
